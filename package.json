{
  "name": "dsh-origin-thesis",
  "version": "1.0.0",
  "description": "Format OriginLab Origin figures to a fixed thesis/journal house style inside DeepSeek Harness: per-layer grid layout, unified fonts and sizes, render-measured axis-title placement, overlap resolution, panel labels, and 600-dpi export with corrected dpi metadata. Ships the plotting scripts; no `mcp` package needed.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "origin",
    "originlab",
    "originpro",
    "scientific-plotting",
    "thesis",
    "figure-formatting",
    "journal-figures",
    "cordis",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinchun2018/dsh-origin-thesis.git"
  },
  "bugs": {
    "url": "https://github.com/xinchun2018/dsh-origin-thesis/issues"
  },
  "homepage": "https://github.com/xinchun2018/dsh-origin-thesis#readme",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README-origin-batch-style.md",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml",
    "export_figures.py",
    "format_composite.py",
    "format_thesis_figures.py",
    "index.js",
    "start-thesis-mcp.cmd",
    "styles.json",
    "sync_to_vendor.ps1",
    "thesis_mcp_server.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
